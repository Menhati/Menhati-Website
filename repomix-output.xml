import Layout from '../../layouts/Layout.astro';
import ScholarshipCard from '../../components/ScholarshipCard.astro';
import { getCollection } from 'astro:content';
import { degreeLabels, statusOf } from '../../lib/scholarship';

const now = Date.now();
const all = (await getCollection('scholarships')).sort(
  (a, b) => a.data.deadline.valueOf() - b.data.deadline.valueOf()
);

const open = all.filter((s) => s.data.deadline.valueOf() >= now);
const closed = all
  .filter((s) => s.data.deadline.valueOf() < now)
  .sort((a, b) => b.data.deadline.valueOf() - a.data.deadline.valueOf());

const countries = [...new Set(all.map((s) => s.data.country))].sort((a, b) => a.localeCompare(b, 'ar'));

/** Lowercased blob used for client-side text matching. */
const haystack = (s: (typeof all)[number]) =>
  [s.data.title, s.data.university ?? '', s.data.country, s.data.major, s.data.awardValue]
    .join(' ')
    .toLowerCase();
