              </svg>
              استشارة مجانية عبر واتساب
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- ── Lead capture ──────────────────────────────────────────────── -->
    <div class="mt-12 lg:mt-16">
      <LeadForm
