<file path="src/pages/scholarships/[slug].astro">
---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import ScholarshipCard from '../../components/ScholarshipCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { flagFor } from '../../lib/flags';
import { whatsappLink } from '../../lib/site';
import { degreeLabels, statusOf, statusLabels, formatDeadline, daysUntil, countdownLabel } from '../../lib/scholarship';

export async function getStaticPaths() {
  const scholarships = await getCollection('scholarships');
  return scholarships.map((s) => ({
    params: { slug: s.slug },
    props: { entry: s },
  }));
}

interface Props {
  entry: CollectionEntry<'scholarships'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();

const waHref = whatsappLink(`مرحباً، أرغب بالتقديم على منحة: ${data.title}`);
const flag = flagFor(data.country);
const deadlineLabel = formatDeadline(data.deadline);
const status = statusOf(data.deadline);
const days = daysUntil(data.deadline);

const statusChip: Record<typeof status, string> = {
  open: 'bg-live/12 text-live',
  closing: 'bg-closing/12 text-closing',
  closed: 'bg-navy-100 text-navy-500',
};

const facts: { label: string; value: string }[] = [
  { label: 'الدولة', value: `${flag} ${data.country}` },
  { label: 'المرحلة الدراسية', value: degreeLabels[data.degreeLevel] },
  { label: 'التخصص', value: data.major },
  { label: 'قيمة المنحة', value: data.awardValue },
  ...(data.gpaMin ? [{ label: 'أقل معدل مطلوب', value: `${data.gpaMin} من ${data.gpaScale}` }] : []),
  ...(data.university ? [{ label: 'الجهة', value: data.university }] : []),
];

// Related: same country first, then same degree level — open ones only.
const now = Date.now();
const pool = (await getCollection('scholarships')).filter(
  (s) => s.slug !== entry.slug && s.data.deadline.valueOf() >= now
);
const related = [
  ...pool.filter((s) => s.data.country === data.country),
  ...pool.filter((s) => s.data.country !== data.country && s.data.degreeLevel === data.degreeLevel),
]
  .filter((s, i, arr) => arr.findIndex((x) => x.slug === s.slug) === i)
  .slice(0, 3);
