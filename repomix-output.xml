<file path="functions/api/lead.ts">
/**
 * POST /api/lead — receives a lead from the site's contact/quiz forms.
 *
 * Runs as a Cloudflare Pages Function (production, or `npx wrangler pages dev`).
 * It does NOT run under plain `astro dev` — there the form falls back to a
 * WhatsApp handoff, so leads are never lost during local development.
 *
 * Every delivery channel is optional and independently configured, so the
 * endpoint keeps working as you add them:
 *
 *   D1 binding   LEADS_DB        → stores the lead in a `leads` table (see schema.sql)
 *   env var      RESEND_API_KEY  → emails the team via Resend
 *   env var      LEAD_TO_EMAIL   → recipient (defaults to info@menhati.com)
 *   env var      LEAD_FROM_EMAIL → verified sender address in Resend
 *
 * With nothing configured it still returns 200, so the visitor never hits an
 * error — the browser then hands them to WhatsApp, which is the real safety net.
 *
 * Setup steps are in README.md → "التقاط بيانات المهتمين (Leads)".
 */

// Minimal local types so this file needs no @cloudflare/workers-types dependency.
interface D1Result {
  success: boolean;
}
interface D1PreparedStatement {
  bind(...values: unknown[]): D1PreparedStatement;
  run(): Promise<D1Result>;
}
interface D1Database {
  prepare(query: string): D1PreparedStatement;
}

interface Env {
  LEADS_DB?: D1Database;
  RESEND_API_KEY?: string;
  LEAD_TO_EMAIL?: string;
  LEAD_FROM_EMAIL?: string;
}

interface EventContext {
  request: Request;
  env: Env;
}

interface LeadPayload {
  name?: string;
  phone?: string;
  message?: string;
  context?: string;
  page?: string;
  website?: string; // honeypot
}

const json = (body: unknown, status = 200) =>
  new Response(JSON.stringify(body), {
    status,
    headers: { 'Content-Type': 'application/json; charset=utf-8' },
  });

const clean = (v: unknown, max: number) => String(v ?? '').trim().slice(0, max);

function escapeHtml(s: string): string {
  return s.replace(
    /[&<>"']/g,
    (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
  );
}

export async function onRequestPost({ request, env }: EventContext): Promise<Response> {
  let payload: LeadPayload;
  try {
    payload = (await request.json()) as LeadPayload;
  } catch {
    return json({ ok: false, error: 'bad_json' }, 400);
  }

  // Honeypot — accept silently so bots don't learn they were caught.
  if (clean(payload.website, 100)) return json({ ok: true });

  const name = clean(payload.name, 120);
  const phone = clean(payload.phone, 40);
  const message = clean(payload.message, 2000);
  const context = clean(payload.context, 200);
  const page = clean(payload.page, 200);

  if (!name || phone.replace(/\D/g, '').length < 8) {
    return json({ ok: false, error: 'validation' }, 400);
  }

  const receivedAt = new Date().toISOString();
  const country = request.headers.get('CF-IPCountry') ?? '';
  const problems: string[] = [];

  // 1) Persist ------------------------------------------------------------
  if (env.LEADS_DB) {
    try {
      await env.LEADS_DB.prepare(
        `INSERT INTO leads (name, phone, message, context, page, country, received_at)
         VALUES (?, ?, ?, ?, ?, ?, ?)`
      )
        .bind(name, phone, message, context, page, country, receivedAt)
        .run();
    } catch (err) {
      problems.push(`d1: ${(err as Error).message}`);
    }
  }

  // 2) Notify the team ----------------------------------------------------
  if (env.RESEND_API_KEY) {
    const to = env.LEAD_TO_EMAIL || 'info@menhati.com';
    const from = env.LEAD_FROM_EMAIL || 'leads@menhati.com';
    const rows: [string, string][] = [
      ['الاسم', name],
      ['واتساب', phone],
      ['بخصوص', context || '—'],
      ['الرسالة', message || '—'],
      ['الصفحة', page || '—'],
      ['الدولة (تقديرية)', country || '—'],
      ['التاريخ', receivedAt],
    ];

    const html =
      `<div dir="rtl" style="font-family:system-ui,sans-serif;line-height:1.9">` +
      `<h2 style="margin:0 0 12px">طلب جديد من موقع منحتي</h2>` +
      `<table cellpadding="6" style="border-collapse:collapse">` +
      rows
        .map(
          ([k, v]) =>
            `<tr><td style="color:#64748b;white-space:nowrap">${k}</td>` +
            `<td><strong>${escapeHtml(v)}</strong></td></tr>`
        )
        .join('') +
      `</table>` +
      `<p style="margin-top:16px">` +
      `<a href="https://wa.me/${phone.replace(/\D/g, '')}" ` +
      `style="background:#3E7A5C;color:#fff;padding:10px 18px;border-radius:8px;text-decoration:none">` +
      `مراسلة ${escapeHtml(name)} على واتساب</a></p></div>`;

    try {
      const res = await fetch('https://api.resend.com/emails', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${env.RESEND_API_KEY}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          from: `منحتي <${from}>`,
          to: [to],
          reply_to: to,
          subject: `طلب جديد من ${name}${context && context !== 'عام' ? ` — ${context}` : ''}`,
          html,
        }),
      });
      if (!res.ok) problems.push(`resend: ${res.status} ${await res.text()}`);
    } catch (err) {
      problems.push(`resend: ${(err as Error).message}`);
    }
  }

  if (problems.length) {
    // Logged for the operator (Cloudflare dashboard → Functions → Logs).
    // The visitor still gets a success response plus the WhatsApp handoff, so a
    // misconfigured backend never costs a lead.
    console.error('[lead] delivery problems:', problems.join(' | '), `name=${name} phone=${phone}`);
  }

  return json({ ok: true });
}

/** Anything that isn't POST gets a clear answer instead of a confusing 404. */
export async function onRequestGet(): Promise<Response> {
  return json({ ok: false, error: 'method_not_allowed' }, 405);
}
</file>

<file path="public/admin/config.yml">
# لوحة تحكم منحتي — إعدادات Decap CMS
#
# ⚠️ قبل التشغيل على الإنترنت: استبدل `repo` أدناه بمسار المستودع الحقيقي على GitHub
#    (مثال: ubakel/menhati)، ثم فعّل مصادقة GitHub كما هو موضح في README.
#
# للتجربة محلياً بدون أي إعداد:
#   1) شغّل الموقع:      npm run dev
#   2) في نافذة أخرى:    npx decap-server
#   3) افتح:             http://localhost:4322/admin
#   (local_backend يجعل التعديلات تُحفظ في ملفات المشروع مباشرة)

backend:
  name: github
  repo: your-org/menhati
  branch: main

local_backend: true

publish_mode: editorial_workflow

media_folder: "public/images/uploads"
public_folder: "/images/uploads"

locale: "ar"

collections:
  - name: "scholarships"
    label: "المنح الدراسية"
    label_singular: "منحة"
    description: "أضف منحة جديدة أو عدّل منحة قائمة. الحقول المعلَّمة بـ * إلزامية."
    folder: "src/content/scholarships"
    create: true
    slug: "{{slug}}"
    identifier_field: title
    summary: "{{title}} — {{country}} ({{deadline | date('YYYY-MM-DD')}})"
    sortable_fields: ["deadline", "title", "country"]
    view_groups:
      - label: "الدولة"
        field: country
      - label: "المرحلة الدراسية"
        field: degreeLevel

    fields:
      - label: "عنوان المنحة *"
        name: "title"
        widget: "string"
        hint: "اكتبه كما يبحث عنه الطالب. مثال: منحة الحكومة التركية (تركيا بورسلاري) للبكالوريوس في تركيا"

      - label: "الدولة *"
        name: "country"
        widget: "string"
        hint: "اسم الدولة بالعربية فقط، مثل: تركيا، ماليزيا، ألمانيا. اكتبه بنفس الصيغة في كل المنح ليعمل الفلتر وعلم الدولة."

      - label: "الجهة المانحة / الجامعة"
        name: "university"
        widget: "string"
        required: false
        hint: "اتركه فارغاً لو كانت منحة حكومية عامة غير مرتبطة بجامعة واحدة."

      - label: "التخصص (نص حر) *"
        name: "major"
        widget: "string"
        hint: "وصف مختصر للتخصصات المتاحة كما تعلنها الجهة. مثال: جميع التخصصات، أو: الهندسة وعلوم الحاسوب"

      - label: "مجالات الدراسة (للفلترة) *"
        name: "fieldCategories"
        widget: "select"
        multiple: true
        min: 1
        hint: "اختر مجالاً واحداً أو أكثر. تُستخدم في اختبار الأهلية. لو كانت المنحة مفتوحة لكل التخصصات اختر «جميع التخصصات»."
        options:
          - "هندسة وتقنية المعلومات"
          - "إدارة أعمال واقتصاد"
          - "طب وعلوم صحية"
          - "علوم طبيعية وتطبيقية"
          - "علوم إنسانية واجتماعية"
          - "قانون"
          - "تربية وتعليم"
          - "إعلام واتصال"
          - "علوم شرعية ودراسات إسلامية"
          - "زراعة وبيئة"
          - "جميع التخصصات"

      - label: "المستوى الدراسي *"
        name: "degreeLevel"
        widget: "select"
        default: "bachelor"
        hint: "لو كانت المنحة تغطي أكثر من مرحلة، اختر المرحلة الأساسية واذكر البقية في التفاصيل بالأسفل."
        options:
          - { label: "بكالوريوس", value: "bachelor" }
          - { label: "ماجستير", value: "master" }
          - { label: "دكتوراه", value: "phd" }
          - { label: "دبلوم", value: "diploma" }

      - label: "نوع التمويل *"
        name: "fundingType"
        widget: "select"
        default: "fully-funded"
        hint: "«ممولة بالكامل» فقط إذا كانت تغطي الرسوم والمعيشة. الإعفاء الجزئي من الرسوم = تمويل جزئي."
        options:
          - { label: "ممولة بالكامل", value: "fully-funded" }
          - { label: "تمويل جزئي", value: "partial" }

      - label: "قيمة المنحة / ما الذي تغطيه *"
        name: "awardValue"
        widget: "text"
        hint: "اذكر ما تغطيه فعلاً بدقة. مثال: تغطية كاملة للرسوم + بدل شهري 934 يورو + تأمين صحي + تذكرة سفر"

      - label: "الموعد النهائي *"
        name: "deadline"
        widget: "datetime"
        date_format: "YYYY-MM-DD"
        time_format: false
        picker_utc: true
        format: "YYYY-MM-DD"
        hint: "آخر موعد للتقديم كما هو معلن رسمياً. المنح المنتهية تبقى ظاهرة في قسم «مغلقة حالياً» — لا تحذفها."

      - label: "أقل معدل مطلوب"
        name: "gpaMin"
        widget: "number"
        required: false
        value_type: "float"
        hint: "اتركه فارغاً إذا لم تعلن الجهة حداً أدنى. اكتب الرقم فقط (مثال: 3 أو 75)."

      - label: "سلّم المعدل"
        name: "gpaScale"
        widget: "select"
        default: "4.0"
        hint: "مهم جداً: اختر السلّم الذي أُعلن به المعدل أعلاه، حتى تعمل المطابقة في اختبار الأهلية بشكل صحيح."
        options:
          - { label: "من 4.0", value: "4.0" }
          - { label: "من 5.0", value: "5.0" }
          - { label: "نسبة مئوية من 100", value: "100" }

      - label: "رابط الجهة الرسمية"
        name: "applyUrl"
        widget: "string"
        required: false
        pattern: ["^https?://.+", "يجب أن يبدأ الرابط بـ http:// أو https://"]
        hint: "رابط الصفحة الرسمية للمنحة (وزارة، سفارة، أو الجامعة). لا تضع رابط موقع تجميع منح."

      - label: "صورة الجامعة / الغلاف"
        name: "image"
        widget: "image"
        required: false
        allow_multiple: false
        hint: "اختياري. استخدم صورة حقيقية للجامعة ومسموح بإعادة نشرها (Wikimedia Commons مثلاً). إن لم تتوفر، سيظهر تصميم بعلم الدولة تلقائياً."

      - label: "نسبة الصورة (المصدر والترخيص)"
        name: "imageCredit"
        widget: "string"
        required: false
        hint: "إلزامي قانونياً عند استخدام صورة بترخيص CC. مثال: الصورة: Revi عبر Wikimedia Commons (CC BY 2.0)"

      - label: "عرضها ضمن المنح المميزة"
        name: "featured"
        widget: "boolean"
        default: false
        required: false
        hint: "المنح المميزة تظهر أولاً في الصفحة الرئيسية (المفتوحة فقط)."

      - label: "تفاصيل المنحة *"
        name: "body"
        widget: "markdown"
        hint: >-
          ابدأ بفقرة تعريفية قصيرة (٢-٤ أسطر)، ثم عنوان «## الشروط الأساسية» بقائمة نقاط،
          ثم «## المستندات المطلوبة» إن توفرت. لا تكتب معلومة غير مؤكدة من المصدر الرسمي.
</file>

