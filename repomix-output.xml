import Layout from '../layouts/Layout.astro';
import ScholarshipCard from '../components/ScholarshipCard.astro';
import { getCollection } from 'astro:content';
import { flagFor } from '../lib/flags';
import { countScholarships } from '../lib/scholarship';

const now = Date.now();
const all = await getCollection('scholarships');
const openOnes = all.filter((s) => s.data.deadline.valueOf() >= now);

// Homepage shows what's actually actionable: open scholarships, soonest first.
// Featured ones float to the top but the list is topped up with other open ones
// so the section never looks empty just because nothing is flagged featured.
const spotlight = [...openOnes]
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return a.data.deadline.valueOf() - b.data.deadline.valueOf();
  })
  .slice(0, 6);

const countryCounts = new Map<string, number>();
for (const s of all) countryCounts.set(s.data.country, (countryCounts.get(s.data.country) ?? 0) + 1);
const topCountries = [...countryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);

const stats = [
  { value: all.length, label: 'منحة موثّقة' },
  { value: openOnes.length, label: 'مفتوحة الآن' },
  { value: countryCounts.size, label: 'دولة حول العالم' },
  { value: all.filter((s) => s.data.fundingType === 'fully-funded').length, label: 'ممولة بالكامل' },
];

const quickFilters = [
  { label: 'ممولة بالكامل', href: '/scholarships?funding=fully-funded' },
  { label: 'بكالوريوس', href: '/scholarships?degree=bachelor' },
  { label: 'ماجستير', href: '/scholarships?degree=master' },
  { label: 'دكتوراه', href: '/scholarships?degree=phd' },
  { label: 'مفتوحة الآن', href: '/scholarships?status=open' },
];

const steps = [
  {
    n: '01',
    title: 'استشارة مجانية',
    body: 'نفهم خلفيتك الأكاديمية وأهدافك عبر واتساب.',
    icon: 'M8 10h16M8 16h10M22 24l-6 5v-5H10a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4h16a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4h-2Z',
  },
  {
    n: '02',
    title: 'مطابقة المنح',
    body: 'نرشح لك المنح الأنسب حسب تخصصك ومعدلك ووجهتك.',
    icon: 'M22 6a16 16 0 1 0 0 32 16 16 0 0 0 0-32Zm0 8a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z',
  },
  {
    n: '03',
    title: 'إعداد الملفات',
    body: 'نكتب خطاب الدافع والسيرة الذاتية ونترجم مستنداتك ترجمة معتمدة.',
    icon: 'M13 6h13l7 7v23a2 2 0 0 1-2 2H13a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Zm12 0v7h7M17 22h10M17 27h10M17 17h4',
  },
  {
    n: '04',
    title: 'التقديم والمتابعة',
    body: 'نقدم الطلب ونتابع معك حتى صدور القرار.',
    icon: 'M6 24 38 8 30 38l-8-11-11-3Zm14 11 6-8',
  },
];

const trustPoints = [
  {
    title: 'من المصدر الرسمي فقط',
    body: 'كل منحة هنا مأخوذة من الموقع الرسمي للجهة المانحة — وزارة، سفارة، أو الجامعة نفسها. لا ننقل عن مواقع تجميع.',
    icon: 'M12 3 4 6.5v5c0 4.6 3.2 8.9 8 10 4.8-1.1 8-5.4 8-10v-5L12 3Z M9 12l2 2 4-4',
  },
  {
    title: 'مواعيد محدّثة ومراجَعة',
    body: 'نتحقق من كل موعد نهائي قبل نشره، ونصحّح ما ينشر خطأً في مواقع أخرى.',
    icon: 'M12 7v5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z',
  },
  {
    title: 'نعرض المغلقة أيضاً',
    body: 'لا نحذف المنح بعد انتهائها. تبقى معروضة بوضوح كي تعرف موعدها المتوقع في الدورة القادمة.',
