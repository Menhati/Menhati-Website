awardValue: "تغطية كاملة للرسوم الدراسية + السكن الجامعي + تأمين صحي (البدل الشهري وتفاصيل السكن تُنسّق مباشرة مع الجامعة المضيفة)"
fundingType: "fully-funded"
degreeLevel: "bachelor"
fieldCategories: ["جميع التخصصات"]
deadline: 2026-01-15
applyUrl: "https://apply.stipendiumhungaricum.hu"
featured: false
