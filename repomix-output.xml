        </select>
        <select id="filter-status" class="filter-select" aria-label="حالة التقديم">
          <option value="any">المفتوحة والمغلقة</option>
          <option value="open">المفتوحة فقط</option>
          <option value="closing">التي تغلق قريباً</option>
          <option value="closed">المغلقة فقط</option>
        </select>
      </div>

      <div class="flex items-center justify-between gap-3 mt-3.5 pt-3.5 border-t border-navy-50">
        <p id="result-count" class="text-[0.8125rem] font-body text-navy-500 tabular" aria-live="polite"></p>
        <button
          id="reset-filters"
          type="button"
          class="text-[0.8125rem] font-body text-navy-400 hover:text-gold-700 transition-colors"
          hidden
        >
          إعادة تعيين
        </button>
      </div>
    </div>

    <!-- ── Open ──────────────────────────────────────────────────────── -->
    <div id="section-open" class="mb-14">
      <h2 class="font-display font-bold text-lg sm:text-xl text-navy-900 mb-5 flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-live"></span>
        منح مفتوحة للتقديم
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {open.map((s, i) => (
          <div
            class="card card-in"
            style={`animation-delay:${Math.min(i, 8) * 55}ms`}
            data-country={s.data.country}
            data-degree={s.data.degreeLevel}
            data-funding={s.data.fundingType}
            data-status={statusOf(s.data.deadline, now)}
            data-search={haystack(s)}
          >
            <ScholarshipCard
              slug={s.slug}
              title={s.data.title}
              major={s.data.major}
              country={s.data.country}
              university={s.data.university}
              gpaMin={s.data.gpaMin}
              gpaScale={s.data.gpaScale}
              awardValue={s.data.awardValue}
              fundingType={s.data.fundingType}
              degreeLevel={s.data.degreeLevel}
              deadline={s.data.deadline}
              image={s.data.image}
              imageCredit={s.data.imageCredit}
              eager={i < 3}
            />
          </div>
        ))}
      </div>
    </div>

    <!-- ── Closed ────────────────────────────────────────────────────── -->
    <div id="section-closed">
      <h2 class="font-display font-bold text-lg sm:text-xl text-navy-900 mb-1.5 flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-navy-300"></span>
        منح مغلقة حالياً
      </h2>
      <p class="text-sm text-navy-500 font-body mb-5 measure leading-[1.95]">
        انتهى موعد التقديم لهذه الدورة، لكن أغلبها يعود سنوياً في نفس الفترة تقريباً —
        احفظها الآن لتكون جاهزاً للدورة القادمة.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {closed.map((s) => (
          <div
            class="card"
            data-country={s.data.country}
            data-degree={s.data.degreeLevel}
            data-funding={s.data.fundingType}
            data-status="closed"
            data-search={haystack(s)}
          >
            <ScholarshipCard
              slug={s.slug}
              title={s.data.title}
              major={s.data.major}
              country={s.data.country}
              university={s.data.university}
              gpaMin={s.data.gpaMin}
              gpaScale={s.data.gpaScale}
              awardValue={s.data.awardValue}
              fundingType={s.data.fundingType}
              degreeLevel={s.data.degreeLevel}
              deadline={s.data.deadline}
              image={s.data.image}
              imageCredit={s.data.imageCredit}
            />
          </div>
        ))}
      </div>
    </div>

    <!-- ── Empty state ───────────────────────────────────────────────── -->
    <div id="no-results" class="text-center py-16" hidden>
      <p class="font-display font-bold text-lg text-navy-900">لا توجد منح مطابقة</p>
      <p class="mt-2 text-sm text-navy-500 font-body measure mx-auto leading-[1.95]">
        جرّب توسيع معايير البحث، أو تواصل معنا مباشرة عبر واتساب وسنبحث لك يدوياً عن الأنسب لحالتك.
      </p>
      <button id="clear-empty" type="button" class="mt-5 bg-navy-900 hover:bg-navy-800 text-white font-body font-semibold text-sm px-6 py-3 rounded-xl transition-colors">
        إعادة تعيين البحث
      </button>
    </div>
  </section>
</Layout>

<style>
  .filter-select {
    @apply w-full rounded-xl border border-navy-100 bg-white px-3 py-2.5 text-[0.8125rem] font-body text-navy-700 focus:border-gold-500 focus:outline-none transition-colors;
  }
</style>

<script>
  const search = document.getElementById('search') as HTMLInputElement;
  const selects = {
    country: document.getElementById('filter-country') as HTMLSelectElement,
    degree: document.getElementById('filter-degree') as HTMLSelectElement,
    funding: document.getElementById('filter-funding') as HTMLSelectElement,
    status: document.getElementById('filter-status') as HTMLSelectElement,
  };
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
  const sectionOpen = document.getElementById('section-open')!;
  const sectionClosed = document.getElementById('section-closed')!;
  const noResults = document.getElementById('no-results')!;
  const countEl = document.getElementById('result-count')!;
  const resetBtn = document.getElementById('reset-filters') as HTMLButtonElement;
  const clearEmptyBtn = document.getElementById('clear-empty') as HTMLButtonElement;

  /** Arabic counted nouns: plural only for 3–10, singular again at 11+. */
  function countLabel(n: number): string {
    if (n === 1) return 'منحة واحدة مطابقة';
    if (n === 2) return 'منحتان مطابقتان';
    if (n >= 3 && n <= 10) return `${n} منح مطابقة`;
    return `${n} منحة مطابقة`;
  }

  /** Seed controls from the URL so hero chips like ?country=… deep-link here. */
  function readUrl() {
    const p = new URLSearchParams(location.search);
    if (p.get('q')) search.value = p.get('q')!;
    for (const [key, el] of Object.entries(selects)) {
      const v = p.get(key);
      if (v && [...el.options].some((o) => o.value === v)) el.value = v;
    }
  }

  function apply() {
    const q = search.value.trim().toLowerCase();
    const country = selects.country.value;
    const degree = selects.degree.value;
    const funding = selects.funding.value;
    const status = selects.status.value;

    let visibleOpen = 0;
    let visibleClosed = 0;

    for (const card of cards) {
      const cardStatus = card.dataset.status ?? '';
      const matchStatus =
        status === 'any' ||
        (status === 'open' ? cardStatus !== 'closed' : cardStatus === status);

      const match =
        (!q || (card.dataset.search ?? '').includes(q)) &&
        (country === 'any' || card.dataset.country === country) &&
        (degree === 'any' || card.dataset.degree === degree) &&
        (funding === 'any' || card.dataset.funding === funding) &&
        matchStatus;

      card.hidden = !match;
      if (match) {
        if (cardStatus === 'closed') visibleClosed++;
        else visibleOpen++;
      }
    }

    sectionOpen.hidden = visibleOpen === 0;
    sectionClosed.hidden = visibleClosed === 0;
    const total = visibleOpen + visibleClosed;
    noResults.hidden = total > 0;
    countEl.textContent = total > 0 ? countLabel(total) : '';

    const dirty =
      !!q || country !== 'any' || degree !== 'any' || funding !== 'any' || status !== 'any';
    resetBtn.hidden = !dirty;

    // Keep the URL shareable without adding history entries on every keystroke.
    const p = new URLSearchParams();
    if (q) p.set('q', q);
    if (country !== 'any') p.set('country', country);
    if (degree !== 'any') p.set('degree', degree);
    if (funding !== 'any') p.set('funding', funding);
    if (status !== 'any') p.set('status', status);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function reset() {
    search.value = '';
    for (const el of Object.values(selects)) el.value = 'any';
    apply();
    search.focus();
  }

  let timer: number;
  search.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(apply, 150);
  });
  for (const el of Object.values(selects)) el.addEventListener('change', apply);
  resetBtn.addEventListener('click', reset);
  clearEmptyBtn.addEventListener('click', reset);

  readUrl();
  apply();
</script>
</file>

