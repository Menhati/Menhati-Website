---
import CardCover from './CardCover.astro';
import { statusOf, degreeLabel, formatDeadline, countdownLabel } from '../lib/scholarship';
import { getLangFromUrl, useTranslations } from '../lib/i18n';

interface Props {
  /** URL path for this scholarship (already localized by the caller). */
  href: string;
  title: string;
  major: string;
  country: string;
  university?: string;
  gpaMin?: number;
  gpaScale?: '4.0' | '5.0' | '100';
  awardValue: string;
  fundingType: 'fully-funded' | 'partial';
  degreeLevel: 'bachelor' | 'master' | 'phd' | 'diploma';
  deadline: Date;
  image?: string;
  imageCredit?: string;
  eager?: boolean;
}

const {
  href, title, major, country, university,
  gpaMin, gpaScale, awardValue, fundingType, degreeLevel,
  deadline, image, imageCredit, eager,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const status = statusOf(deadline);
const countdown = countdownLabel(deadline, lang);

// The countdown sits on the cover as a solid pill — high contrast against any
// photo, and colour-coded so urgency reads at a glance.
const countdownStyles: Record<typeof status, string> = {
  open: 'bg-white text-navy-900',
  closing: 'bg-closing text-white',
  closed: 'bg-navy-800/90 text-navy-100',
};
---

<article class="group h-full">
  <a
    href={href}
    class="flex h-full flex-col bg-white border border-navy-100 rounded-xl overflow-hidden transition-all duration-300 hover:border-gold-500/70 hover:shadow-[0_14px_36px_-14px_rgba(10,27,48,0.32)] hover:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
  >
    <div class="relative">
      <CardCover
        image={image}
        imageCredit={imageCredit}
        country={country}
        alt={university ?? title}
        eager={eager}
      />
      <span
        class={`absolute top-2.5 inset-inline-end-2.5 text-[0.8125rem] font-body font-bold px-3 py-1.5 rounded-lg shadow-sm tabular ${countdownStyles[status]}`}
      >
        {countdown}
      </span>
    </div>

    <div class="flex flex-1 flex-col p-5">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span
          class:list={[
            'text-xs font-body font-bold px-2.5 py-1 rounded-md',
            fundingType === 'fully-funded' ? 'bg-live/12 text-live' : 'bg-gold-100 text-gold-700',
          ]}
        >
          {fundingType === 'fully-funded' ? t('card.fullyFunded') : t('card.partial')}
        </span>
        <span class="text-xs font-body font-semibold px-2.5 py-1 rounded-md bg-navy-50 text-navy-600">
          {degreeLabel(degreeLevel, lang)}
        </span>
      </div>

      <!-- min-heights reserve two lines each so titles/summaries of different
           lengths still line up across a row instead of leaving a dead gap -->
      <h3 class="font-display font-bold text-navy-900 text-[1.1875rem] leading-[1.6] line-clamp-2 min-h-[3.8rem] group-hover:text-gold-700 transition-colors">
        {title}
      </h3>

      <p class="mt-2 text-[0.9375rem] leading-[1.9] text-navy-600 line-clamp-2 min-h-[3.5rem] font-body">
        {awardValue}
      </p>

      <!-- Meta pinned to the bottom so cards in a row stay aligned -->
      <dl class="mt-auto pt-5 space-y-2 text-[0.9375rem] font-body">
        <div class="flex items-start gap-2.5">
          <dt class="text-navy-400 shrink-0">{t('card.major')}</dt>
          <dd class="text-navy-800 font-medium line-clamp-1">{major}</dd>
        </div>
        {gpaMin && (
          <div class="flex items-center gap-2.5">
            <dt class="text-navy-400 shrink-0">{t('card.minGpa')}</dt>
            <dd class="text-navy-800 font-medium tabular">{gpaMin} {t('card.outOf')} {gpaScale}</dd>
          </div>
        )}
      </dl>

      <div class="mt-4 pt-4 border-t border-navy-50 flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 text-[0.875rem] text-navy-500 font-body tabular">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" class="shrink-0 text-navy-300">
            <rect x="3" y="5" width="18" height="16" rx="2" /><path stroke-linecap="round" d="M8 3v4M16 3v4M3 10h18" />
          </svg>
          {formatDeadline(deadline, lang)}
        </span>
        <span class="text-[0.875rem] font-body font-bold text-gold-700 inline-flex items-center gap-1 shrink-0">
          {t('card.details')}
          <!-- Arrow points in the reading-forward direction: left in RTL,
               flipped to right in LTR. -->
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 transition-transform ltr:rotate-180 group-hover:scale-110">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M11 18l-6-6 6-6" />
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>
