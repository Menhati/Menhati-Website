---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../LeadForm.astro';
import ScholarshipCard from '../ScholarshipCard.astro';
import { flagFor, countryName } from '../../lib/flags';
import { whatsappLink } from '../../lib/site';
import {
  degreeLabel,
  statusOf,
  statusLabel,
  formatDeadline,
  daysUntil,
  countdownLabel,
} from '../../lib/scholarship';
import { getLangFromUrl, useTranslations, localizePath } from '../../lib/i18n';
import { getScholarshipsFor, scholarshipPath, type ScholarshipView } from '../../lib/content';

interface Props {
  view: ScholarshipView;
}

const { view } = Astro.props;
const { data } = view;
const { Content } = await view.entry.render();

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const waHref = whatsappLink(`${t('wa.apply')} ${data.title}`);
const flag = flagFor(data.country);
const deadlineLabel = formatDeadline(data.deadline, lang);
const status = statusOf(data.deadline);
const days = daysUntil(data.deadline);

// True when we're showing the Arabic entry on the English site because no
// translation exists yet — the structural fields are still localized, but the
// written body isn't, so we say so rather than silently mixing languages.
const untranslated = !view.translated && lang !== 'ar';

const statusChip: Record<typeof status, string> = {
  open: 'bg-live/12 text-live',
  closing: 'bg-closing/12 text-closing',
  closed: 'bg-navy-100 text-navy-500',
};

const facts: { label: string; value: string }[] = [
  { label: t('detail.country'), value: `${flag} ${countryName(data.country, lang)}` },
  { label: t('detail.degree'), value: degreeLabel(data.degreeLevel, lang) },
  { label: t('detail.major'), value: data.major },
  { label: t('detail.award'), value: data.awardValue },
  ...(data.gpaMin
    ? [{ label: t('detail.minGpa'), value: `${data.gpaMin} ${t('card.outOf')} ${data.gpaScale}` }]
    : []),
  ...(data.university ? [{ label: t('detail.provider'), value: data.university }] : []),
];

// Related: same country first, then same degree level — open ones only, in the
// current language (falling back the same way the listing does).
const now = Date.now();
const pool = (await getScholarshipsFor(lang)).filter(
  (s) => s.key !== view.key && s.data.deadline.valueOf() >= now
);

const related = [
  ...pool.filter((s) => s.data.country === data.country),
  ...pool.filter((s) => s.data.country !== data.country && s.data.degreeLevel === data.degreeLevel),
]
  .filter((s, i, arr) => arr.findIndex((x) => x.key === s.key) === i)
  .slice(0, 3);
---

<Layout title={data.title} description={`${data.title} — ${data.awardValue}`} hasMobileCta>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10 pb-28 lg:pb-12">
    <a
      href={localizePath('/scholarships', lang)}
      class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-navy-400 hover:text-gold-700 transition-colors mb-5 font-body font-semibold"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="ltr:rotate-180">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M11 6l6 6-6 6" />
      </svg>
      {t('detail.back')}
    </a>

    {data.image && (
      <figure class="relative rounded-2xl overflow-hidden mb-7 aspect-[21/9] bg-navy-900 shadow-sm">
        <img src={data.image} alt={data.university ?? data.title} class="w-full h-full object-cover" />
        {data.imageCredit && (
          /* Attribution is a condition of the CC licences these photos are under */
          <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-navy-950/80 to-transparent px-3 pt-6 pb-2 text-[10px] sm:text-[11px] text-white/80 font-body text-start">
            {data.imageCredit}
          </figcaption>
        )}
      </figure>
    )}

    <div class="grid lg:grid-cols-[1fr_320px] gap-8 lg:gap-12 items-start">
      <!-- ── Main ────────────────────────────────────────────────────── -->
      <article class="min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class={`text-[11px] font-body font-bold px-2.5 py-1 rounded-md ${statusChip[status]}`}>
            {status === 'closing'
              ? `${countdownLabel(data.deadline, lang)}`
              : statusLabel(status, lang)}
          </span>
          <span
            class:list={[
              'text-[11px] font-body font-bold px-2.5 py-1 rounded-md',
              data.fundingType === 'fully-funded' ? 'bg-gold-100 text-gold-700' : 'bg-navy-50 text-navy-600',
            ]}
          >
            {data.fundingType === 'fully-funded' ? t('card.fullyFunded') : t('card.partial')}
          </span>
          <span class="text-[11px] font-body font-semibold px-2.5 py-1 rounded-md bg-navy-50 text-navy-600">
            {degreeLabel(data.degreeLevel, lang)}
          </span>
        </div>

        <h1 class="font-display font-black text-[1.6rem] sm:text-[2rem] lg:text-[2.35rem] leading-[1.35] text-navy-900">
          {data.title}
        </h1>

        {data.university && <p class="mt-2.5 text-navy-500 text-sm font-body">{data.university}</p>}

        <!-- Mobile fact strip (sidebar is desktop-only) -->
        <dl class="lg:hidden mt-6 grid grid-cols-2 gap-3">
          {facts.slice(0, 4).map((f) => (
            <div class="bg-white border border-navy-100 rounded-xl p-3">
              <dt class="text-[0.6875rem] text-navy-400 font-body">{f.label}</dt>
              <dd class="text-[0.8125rem] text-navy-900 font-body font-semibold mt-0.5 leading-[1.7]">{f.value}</dd>
            </div>
          ))}
        </dl>

        {untranslated && (
          <p
            dir="ltr"
            class="mt-7 flex items-start gap-2.5 text-[0.8125rem] font-body text-navy-600 bg-navy-50 border border-navy-100 rounded-xl px-4 py-3 text-start"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-navy-400">
              <circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 8h.01M11 12h1v4h1" />
            </svg>
            {t('detail.arabicOnly')}
          </p>
        )}

        <div class="mt-8 pt-8 border-t border-navy-100 mh-prose" dir={untranslated ? 'rtl' : undefined}>
          <Content />
        </div>

        {data.applyUrl && (
          <a
            href={data.applyUrl}
            target="_blank"
            rel="noopener"
            class="mt-8 inline-flex items-center gap-2 text-sm font-body font-semibold text-gold-700 hover:text-gold-500 transition-colors"
          >
            {t('detail.officialSite')}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5M19 5l-9 9M9 5H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-3" />
            </svg>
          </a>
        )}
      </article>

      <!-- ── Sidebar ─────────────────────────────────────────────────── -->
      <aside class="hidden lg:block sticky top-24">
        <div class="border border-navy-100 rounded-2xl bg-white overflow-hidden shadow-sm">
          <!-- Server-rendered so it's correct on first paint -->
          <div
            class:list={[
              'px-5 py-5 text-center border-b',
              status === 'closed' ? 'bg-navy-50 border-navy-100' : 'bg-navy-900 border-navy-900',
            ]}
          >
            <span
              class:list={[
                'block text-[0.6875rem] font-body',
                status === 'closed' ? 'text-navy-500' : 'text-navy-200',
              ]}
            >
              {status === 'closed' ? t('detail.ended') : t('detail.closesIn')}
            </span>
            <span
              class:list={[
                'block font-display font-black text-2xl mt-1 tabular',
                status === 'closing' ? 'text-closing' : status === 'closed' ? 'text-navy-500' : 'text-gold-300',
              ]}
            >
              {status === 'closed'
                ? statusLabel('closed', lang)
                : lang === 'ar'
                  ? countdownLabel(data.deadline, 'ar').replace('متبقٍ ', '')
                  : countdownLabel(data.deadline, 'en').replace(' left', '')}
            </span>
            <span
              class:list={[
                'block text-[0.8125rem] mt-2 font-body tabular',
                status === 'closed' ? 'text-navy-500' : 'text-navy-100',
              ]}
            >
              {deadlineLabel}
            </span>
          </div>

          <dl class="px-5 py-5 flex flex-col gap-3.5">
            {facts.map((f) => (
              <div>
                <dt class="text-[0.6875rem] text-navy-400 font-body">{f.label}</dt>
                <dd class="text-[0.8125rem] text-navy-900 font-body font-semibold mt-0.5 leading-[1.75]">{f.value}</dd>
              </div>
            ))}
          </dl>

          <div class="px-5 pb-5">
            <a
              href={waHref}
              target="_blank"
              rel="noopener"
              class="w-full inline-flex items-center justify-center gap-2 bg-gold-500 hover:bg-gold-300 text-navy-900 font-body font-bold text-sm px-5 py-3.5 rounded-xl transition-colors"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.1c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.11.11-1.79-.11-.41-.13-.94-.3-1.62-.6-2.85-1.23-4.71-4.1-4.85-4.29-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.08.99-2.37.26-.28.57-.35.76-.35h.55c.18 0 .41-.07.64.49.24.58.81 2 .88 2.14.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.14-.28.29-.12.56.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.19-.28.37-.23.62-.14.26.09 1.63.77 1.9.91.28.14.46.21.53.33.07.12.07.68-.17 1.35Z"/>
              </svg>
              {t('detail.consult')}
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- ── Lead capture ──────────────────────────────────────────────── -->
    <div class="mt-12 lg:mt-16">
      <LeadForm context={data.title} title={t('detail.leadTitle')} subtitle={t('detail.leadSubtitle')} />
    </div>

    <!-- ── Related ───────────────────────────────────────────────────── -->
    {related.length > 0 && (
      <section class="mt-14">
        <h2 class="font-display font-bold text-lg sm:text-xl text-navy-900 mb-5">{t('detail.related')}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {related.map((s) => (
            <ScholarshipCard
              href={scholarshipPath(s.key, lang)}
              title={s.data.title}
              major={s.data.major}
              country={s.data.country}
              university={s.data.university}
              gpaMin={s.data.gpaMin}
              gpaScale={s.data.gpaScale}
              awardValue={s.data.awardValue}
              fundingType={s.data.fundingType}
              degreeLevel={s.data.degreeLevel}
              deadline={s.data.deadline}
              image={s.data.image}
              imageCredit={s.data.imageCredit}
            />
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- Mobile sticky CTA -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-navy-900/95 backdrop-blur-md border-t border-navy-700/80 py-3 px-4 flex items-center justify-between gap-3">
    <div class="min-w-0">
      <span class="text-[10px] text-navy-300 block font-body">{t('detail.deadline')}</span>
      <span class="text-xs font-bold text-white tabular">{deadlineLabel}</span>
    </div>
    <a
      href={waHref}
      target="_blank"
      rel="noopener"
      class="shrink-0 bg-gold-500 text-navy-900 font-body font-bold text-xs px-5 py-2.5 rounded-xl active:scale-95 transition-transform"
    >
      {t('detail.consultShort')}
    </a>
  </div>
</Layout>
