---
import Layout from '../../layouts/Layout.astro';
import ScholarshipCard from '../ScholarshipCard.astro';
import { flagFor, countryName } from '../../lib/flags';
import { countScholarships } from '../../lib/scholarship';
import { getLangFromUrl, useTranslations, localizePath } from '../../lib/i18n';
import { getScholarshipsFor, scholarshipPath } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

const now = Date.now();
const all = await getScholarshipsFor(lang);
const openOnes = all.filter((s) => s.data.deadline.valueOf() >= now);

// Homepage shows what's actually actionable: open scholarships, soonest first.
// Featured ones float to the top but the list is topped up with other open ones
// so the section never looks empty just because nothing is flagged featured.
const spotlight = [...openOnes]
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return a.data.deadline.valueOf() - b.data.deadline.valueOf();
  })
  .slice(0, 6);

const countryCounts = new Map<string, number>();
for (const s of all) countryCounts.set(s.data.country, (countryCounts.get(s.data.country) ?? 0) + 1);
const topCountries = [...countryCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

const stats = [
  { value: all.length, label: t('home.statTotal') },
  { value: openOnes.length, label: t('home.statOpen') },
  { value: countryCounts.size, label: t('home.statCountries') },
  { value: all.filter((s) => s.data.fundingType === 'fully-funded').length, label: t('home.statFunded') },
];

const quickFilters = [
  { label: t('home.filterFullyFunded'), href: L('/scholarships?funding=fully-funded') },
  { label: t('home.filterBachelor'), href: L('/scholarships?degree=bachelor') },
  { label: t('home.filterMaster'), href: L('/scholarships?degree=master') },
  { label: t('home.filterPhd'), href: L('/scholarships?degree=phd') },
  { label: t('home.filterOpen'), href: L('/scholarships?status=open') },
];

const steps = [
  {
    n: '01',
    title: t('home.step1Title'),
    body: t('home.step1Body'),
    icon: 'M8 10h16M8 16h10M22 24l-6 5v-5H10a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4h16a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4h-2Z',
  },
  {
    n: '02',
    title: t('home.step2Title'),
    body: t('home.step2Body'),
    icon: 'M22 6a16 16 0 1 0 0 32 16 16 0 0 0 0-32Zm0 8a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z',
  },
  {
    n: '03',
    title: t('home.step3Title'),
    body: t('home.step3Body'),
    icon: 'M13 6h13l7 7v23a2 2 0 0 1-2 2H13a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Zm12 0v7h7M17 22h10M17 27h10M17 17h4',
  },
  {
    n: '04',
    title: t('home.step4Title'),
    body: t('home.step4Body'),
    icon: 'M6 24 38 8 30 38l-8-11-11-3Zm14 11 6-8',
  },
];

const trustPoints = [
  {
    title: t('home.trust1Title'),
    body: t('home.trust1Body'),
    icon: 'M12 3 4 6.5v5c0 4.6 3.2 8.9 8 10 4.8-1.1 8-5.4 8-10v-5L12 3Z M9 12l2 2 4-4',
  },
  { title: t('home.trust2Title'), body: t('home.trust2Body'), icon: 'M12 7v5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z' },
  { title: t('home.trust3Title'), body: t('home.trust3Body'), icon: 'M4 6h16M4 12h16M4 18h10' },
  {
    title: t('home.trust4Title'),
    body: t('home.trust4Body'),
    icon: 'M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z',
  },
];
---

<Layout title={t('nav.home')}>
  <!-- ── Hero: search-first ───────────────────────────────────────────── -->
  <section class="relative bg-navy-900 text-white overflow-hidden">
    <div class="absolute inset-0 pattern-lattice opacity-70" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-radial-glow" aria-hidden="true"></div>

    <div class="relative max-w-4xl mx-auto px-5 py-16 sm:py-24 text-center">
      <span class="inline-flex items-center gap-2 text-xs sm:text-sm font-body font-semibold text-gold-300 bg-gold-500/10 border border-gold-500/25 rounded-full px-3.5 py-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-300"></span>
        {t('home.badge')}
      </span>

      <h1 class="mt-6 font-display font-black text-3xl sm:text-4xl md:text-[3.25rem] md:leading-[1.25]">
        {t('home.title1')} <span class="text-gold-300">{t('home.title2')}</span>
      </h1>

      <p class="mt-5 text-navy-100 text-base sm:text-lg leading-[2] max-w-2xl mx-auto">
        {t('home.subtitle')}
      </p>

      <!-- Works without JS: plain GET form to the listing page -->
      <form action={L('/scholarships')} method="get" class="mt-9 max-w-2xl mx-auto" role="search">
        <label for="hero-search" class="sr-only">{t('home.searchLabel')}</label>
        <div class="flex items-stretch gap-2 bg-white rounded-2xl p-2 shadow-2xl">
          <span class="grid place-items-center ps-3 text-navy-300 shrink-0" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m20 20-3.5-3.5" />
            </svg>
          </span>
          <input
            id="hero-search"
            type="search"
            name="q"
            placeholder={t('home.searchPlaceholder')}
            class="flex-1 min-w-0 bg-transparent text-navy-900 placeholder:text-navy-300 font-body text-sm sm:text-base py-3 focus:outline-none"
          />
          <button
            type="submit"
            class="shrink-0 bg-navy-900 hover:bg-navy-800 text-white font-body font-bold text-sm px-5 sm:px-7 rounded-xl transition-colors"
          >
            {t('home.searchButton')}
          </button>
        </div>
      </form>

      <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
        <span class="text-xs text-navy-300 font-body">{t('home.popular')}</span>
        {quickFilters.map((f) => (
          <a
            href={f.href}
            class="text-xs sm:text-[0.8125rem] font-body text-navy-100 bg-white/10 hover:bg-white/20 border border-white/15 rounded-full px-3 py-1.5 transition-colors"
          >
            {f.label}
          </a>
        ))}
      </div>

      <dl class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-y-6 gap-x-4 border-t border-white/10 pt-8">
        {stats.map((s) => (
          <div>
            <dd class="font-display font-black text-2xl sm:text-3xl text-gold-300 tabular">{s.value}</dd>
            <dt class="text-xs sm:text-[0.8125rem] text-navy-200 mt-1 font-body">{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Browse by country ────────────────────────────────────────────── -->
  {topCountries.length > 0 && (
    <section class="max-w-6xl mx-auto px-5 py-14 sm:py-16">
      <div class="flex items-baseline justify-between gap-4 mb-6">
        <h2 class="font-display font-bold text-xl sm:text-2xl text-navy-900">{t('home.byCountry')}</h2>
        <a href={L('/scholarships')} class="text-sm font-body text-gold-700 hover:text-gold-500 shrink-0">
          {t('home.allCountries')} ←
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {topCountries.map(([country, count]) => (
          <a
            href={L(`/scholarships?country=${encodeURIComponent(country)}`)}
            class="group flex items-center gap-3 bg-white border border-navy-100 rounded-xl px-3.5 py-3 hover:border-gold-500/70 hover:shadow-md transition-all"
          >
            <span class="text-2xl shrink-0" aria-hidden="true">{flagFor(country)}</span>
            <span class="min-w-0">
              <span class="block font-body font-semibold text-[0.8125rem] text-navy-900 truncate group-hover:text-gold-700 transition-colors">
                {countryName(country, lang)}
              </span>
              <span class="block text-[0.6875rem] text-navy-400 tabular">{countScholarships(count, lang)}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ── Spotlight scholarships ───────────────────────────────────────── -->
  {spotlight.length > 0 && (
    <section class="bg-white border-y border-navy-100">
      <div class="max-w-6xl mx-auto px-5 py-14 sm:py-16">
        <div class="flex items-baseline justify-between gap-4 mb-2">
          <h2 class="font-display font-bold text-xl sm:text-2xl text-navy-900">{t('home.openNow')}</h2>
          <a href={L('/scholarships')} class="text-sm font-body text-gold-700 hover:text-gold-500 shrink-0">
            {t('home.viewAll')} ←
          </a>
        </div>
        <p class="text-sm text-navy-500 font-body mb-7">{t('home.openNowSub')}</p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {spotlight.map((s, i) => (
            <div class="card-in" style={`animation-delay:${Math.min(i, 6) * 70}ms`}>
              <ScholarshipCard
                href={scholarshipPath(s.key, lang)}
                title={s.data.title}
                major={s.data.major}
                country={s.data.country}
                university={s.data.university}
                gpaMin={s.data.gpaMin}
                gpaScale={s.data.gpaScale}
                awardValue={s.data.awardValue}
                fundingType={s.data.fundingType}
                degreeLevel={s.data.degreeLevel}
                deadline={s.data.deadline}
                image={s.data.image}
                imageCredit={s.data.imageCredit}
                eager={i < 3}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <section id="how-it-works" class="py-14 sm:py-16 overflow-hidden">
    <div class="max-w-6xl mx-auto px-5">
      <h2 class="font-display font-bold text-xl sm:text-2xl text-navy-900">{t('home.howTitle')}</h2>
      <p class="text-sm text-navy-500 font-body mt-2 mb-12 md:mb-16">{t('home.howSub')}</p>

      <ol class="relative grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-6">
        <div
          class="pointer-events-none absolute hidden md:block top-7 h-0 border-t-2 border-dashed border-gold-500/40"
          style="inset-inline: 12.5%;"
          aria-hidden="true"
        ></div>

        {steps.map((step, i) => (
          <li class="group relative flex md:flex-col items-start md:items-center gap-4 md:gap-0 md:text-center">
            <div class="relative shrink-0">
              <span class="relative z-10 flex items-center justify-center w-14 h-14 rounded-full bg-navy-900 text-gold-300 ring-4 ring-paper border border-gold-500/50 group-hover:bg-gold-500 group-hover:text-navy-900 transition-colors">
                <svg width="22" height="22" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={step.icon} />
                </svg>
              </span>
              {i < steps.length - 1 && (
                <span
                  class="md:hidden absolute top-14 start-1/2 -translate-x-1/2 w-0 h-10 border-s-2 border-dashed border-gold-500/40"
                  aria-hidden="true"
                ></span>
              )}
            </div>
            <div class="md:mt-4">
              <span class="font-display font-black text-gold-500 text-sm tabular">{step.n}</span>
              <h3 class="font-display font-bold text-navy-900 mt-0.5">{step.title}</h3>
              <p class="text-sm text-navy-600 mt-1 leading-[1.9] md:max-w-[15rem]">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Trust / how we verify ────────────────────────────────────────── -->
  <section class="bg-navy-900 text-white pattern-lattice">
    <div class="max-w-6xl mx-auto px-5 py-14 sm:py-16">
      <div class="max-w-2xl">
        <h2 class="font-display font-bold text-xl sm:text-2xl">{t('home.trustTitle')}</h2>
        <p class="mt-3 text-navy-100 text-sm sm:text-base leading-[2]">{t('home.trustSub')}</p>
      </div>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {trustPoints.map((p) => (
          <div class="bg-white/[0.06] border border-white/10 rounded-xl p-5 hover:border-gold-500/40 transition-colors">
            <span class="grid place-items-center w-11 h-11 rounded-lg bg-gold-500/15 text-gold-300">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon} />
              </svg>
            </span>
            <h3 class="font-display font-bold mt-4 text-[1.0625rem]">{p.title}</h3>
            <p class="mt-2 text-[0.8125rem] text-navy-100 leading-[1.95]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Closing CTA ──────────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-5 py-14 sm:py-20">
    <div class="bg-gradient-to-br from-gold-100 to-paper border border-gold-500/30 rounded-2xl p-7 sm:p-12 text-center">
      <h2 class="font-display font-black text-2xl sm:text-3xl text-navy-900">{t('home.ctaTitle')}</h2>
      <p class="mt-4 text-navy-600 text-sm sm:text-base leading-[2] max-w-xl mx-auto">{t('home.ctaBody')}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={L('/quiz')}
          class="bg-navy-900 hover:bg-navy-800 text-white font-body font-bold px-7 py-3.5 rounded-xl transition-colors"
        >
          {t('home.ctaPrimary')}
        </a>
        <a
          href={L('/scholarships')}
          class="bg-white border border-navy-200 hover:border-navy-900 text-navy-900 font-body font-semibold px-7 py-3.5 rounded-xl transition-colors"
        >
          {t('home.ctaSecondary')}
        </a>
      </div>
    </div>
  </section>
</Layout>
