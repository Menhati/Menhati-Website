---
import { flagFor } from '../lib/flags';
---

<div class="w-full max-w-md mx-auto px-2 sm:px-0">
  <!-- Outer Glow Container -->
  <div class="relative bg-gradient-to-b from-navy-800 to-navy-950 border border-white/20 rounded-3xl p-5 sm:p-7 shadow-2xl backdrop-blur-2xl">
    
    <!-- Top Status Line -->
    <div class="flex items-center justify-between gap-2 mb-6 pb-4 border-b border-white/10">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
        <span class="text-xs sm:text-sm font-bold text-white font-body">فلاتر البحث التفاعلية</span>
      </div>
      <span class="text-xs font-bold text-gold-300 bg-gold-500/15 border border-gold-500/30 px-3 py-1 rounded-full font-body">
        تحديث مباشر
      </span>
    </div>

    <!-- Active Filter Chips Visual -->
    <div class="space-y-3 mb-6">
      <p class="text-xs text-slate-300 font-body font-medium">حدد معاييرك للتصفية السريعة:</p>
      
      <div class="flex flex-wrap gap-2">
        <div class="bg-white/10 hover:bg-white/15 border border-white/20 text-white text-xs sm:text-sm font-bold px-3.5 py-2 rounded-xl font-body flex items-center gap-2">
          <span>{flagFor('ألمانيا')}</span>
          <span>ألمانيا</span>
        </div>
        <div class="bg-white/10 hover:bg-white/15 border border-white/20 text-white text-xs sm:text-sm font-bold px-3.5 py-2 rounded-xl font-body flex items-center gap-2">
          <span>🎓</span>
          <span>بكالوريوس</span>
        </div>
        <div class="bg-gold-500/20 border border-gold-500/40 text-gold-300 text-xs sm:text-sm font-bold px-3.5 py-2 rounded-xl font-body flex items-center gap-2">
          <span>⚡</span>
          <span>تمويل كامل</span>
        </div>
      </div>
    </div>

    <!-- Live Counter Preview Box -->
    <div class="bg-navy-900/90 border border-gold-500/30 rounded-2xl p-4 mb-6 text-center">
      <span class="text-xs text-slate-300 font-body block mb-1">الفرص المتاحة حسب هذه المعايير</span>
      <span class="text-2xl sm:text-3xl font-display font-black text-gold-400 tracking-tight">14 منحة مفتوحة</span>
    </div>

    <!-- Direct CTA Launch Button -->
    <a
      href="/quiz"
      class="w-full bg-gold-400 hover:bg-gold-300 active:scale-[0.98] text-navy-950 font-body font-bold text-sm sm:text-base py-4 px-6 rounded-2xl shadow-lg transition-all flex items-center justify-center gap-3 text-center touch-manipulation min-h-[52px]"
    >
      <span>ابدأ تصفية المنح الآن</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="rotate-180 shrink-0">
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>

  </div>
</div>