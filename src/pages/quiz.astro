---
import Layout from '../layouts/Layout.astro';
import ScholarshipCard from '../components/ScholarshipCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCollection } from 'astro:content';
import { degreeLabels, fieldCategories } from '../lib/scholarship';

const all = (await getCollection('scholarships'))
  .filter((s) => s.data.deadline.valueOf() >= Date.now())
  .sort((a, b) => a.data.deadline.valueOf() - b.data.deadline.valueOf());

const countries = [...new Set(all.map((s) => s.data.country))].sort((a, b) => a.localeCompare(b, 'ar'));
---

<Layout
  title="اعثر على منحتك"
  description="حدّد تخصصك ومعدلك ووجهتك، وسنعرض لك فوراً المنح الدراسية التي تنطبق عليك شروطها."
>
  <section class="max-w-4xl mx-auto px-5 py-10 sm:py-14">
    <header class="text-center max-w-xl mx-auto">
      <span class="inline-flex items-center gap-2 text-xs font-body font-semibold text-gold-700 bg-gold-100 rounded-full px-3.5 py-1.5">
        مطابقة فورية — بدون تسجيل
      </span>
      <h1 class="mt-5 font-display font-black text-2xl sm:text-3xl text-navy-900">اعثر على منحتك</h1>
      <p class="mt-3 text-navy-500 font-body text-sm sm:text-base leading-[1.95]">
        اختر مرحلتك ومجالك ومعدلك، وسنعرض لك فوراً المنح المفتوحة التي تنطبق عليك شروطها المعلنة.
      </p>
    </header>

    <form
      id="quiz-form"
      class="mt-9 grid sm:grid-cols-2 gap-4 bg-white border border-navy-100 rounded-2xl p-5 sm:p-6 shadow-sm"
    >
      <label class="block">
        <span class="block text-xs font-body text-navy-600 mb-1.5">المرحلة الدراسية</span>
        <select name="degreeLevel" class="quiz-input">
          <option value="any">أي مرحلة</option>
          {Object.entries(degreeLabels).map(([value, label]) => (
            <option value={value}>{label}</option>
          ))}
        </select>
      </label>

      <label class="block">
        <span class="block text-xs font-body text-navy-600 mb-1.5">مجال الدراسة</span>
        <select name="category" class="quiz-input">
          <option value="any">كل المجالات</option>
          {fieldCategories.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>

      <label class="block">
        <span class="block text-xs font-body text-navy-600 mb-1.5">الدولة المفضّلة</span>
        <select name="country" class="quiz-input">
          <option value="any">كل الدول</option>
          {countries.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>

      <div class="block">
        <span class="block text-xs font-body text-navy-600 mb-1.5">معدلك التراكمي</span>
        <div class="flex gap-2">
          <input
            type="number" name="gpa" min="0" step="0.01"
            placeholder="مثال: 3.2"
            class="quiz-input flex-1 min-w-0"
          />
          <select name="gpaScale" class="quiz-input w-auto shrink-0 text-xs" aria-label="سلّم المعدل">
            <option value="4.0">من 4.0</option>
            <option value="5.0">من 5.0</option>
            <option value="100">من 100٪</option>
          </select>
        </div>
      </div>

      <button
        type="submit"
        class="sm:col-span-2 bg-navy-900 hover:bg-navy-800 text-white font-body font-bold px-6 py-3.5 rounded-xl transition-colors"
      >
        اعرض المنح المناسبة لي
      </button>
    </form>

    <!-- ── Results ───────────────────────────────────────────────────── -->
    <div id="quiz-results" class="mt-12" hidden>
      <div class="flex items-baseline justify-between gap-3 mb-6">
        <h2 class="font-display font-bold text-xl text-navy-900">النتائج</h2>
        <span id="quiz-count" class="text-sm text-navy-500 font-body tabular"></span>
      </div>

      <div id="quiz-grid" class="grid sm:grid-cols-2 gap-5">
        {all.map((s) => (
          <div
            data-degree={s.data.degreeLevel}
            data-categories={s.data.fieldCategories.join('|')}
            data-country={s.data.country}
            data-gpamin={s.data.gpaMin ?? ''}
            data-gpascale={s.data.gpaScale}
          >
            <ScholarshipCard
              slug={s.slug}
              title={s.data.title}
              major={s.data.major}
              country={s.data.country}
              university={s.data.university}
              gpaMin={s.data.gpaMin}
              gpaScale={s.data.gpaScale}
              awardValue={s.data.awardValue}
              fundingType={s.data.fundingType}
              degreeLevel={s.data.degreeLevel}
              deadline={s.data.deadline}
              image={s.data.image}
              imageCredit={s.data.imageCredit}
            />
          </div>
        ))}
      </div>

      <div id="quiz-empty" class="text-center py-14" hidden>
        <p class="font-display font-bold text-lg text-navy-900">لا توجد منحة مطابقة تماماً</p>
        <p class="mt-2 text-sm text-navy-500 font-body max-w-md mx-auto leading-[1.95]">
          هذا لا يعني أن الفرص انتهت — كثير من المنح لا تنشر شروط المعدل بدقة، وبعضها يفتح دورات جديدة قريباً.
          اترك بياناتك أدناه وسنبحث لك يدوياً.
        </p>
      </div>

      <!-- Lead capture: the actual conversion point of the whole page -->
      <div class="mt-10">
        <LeadForm
          context="اعثر على منحتك"
          title="نساعدك في الخطوة التالية"
          subtitle="اترك اسمك ورقم واتساب، وسنراجع نتيجتك ونرشّح لك المنح الأنسب ونخبرك بالمستندات المطلوبة لكل منها."
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .quiz-input {
    @apply w-full rounded-xl border border-navy-100 bg-white px-3.5 py-3 text-sm font-body text-navy-900
           placeholder:text-navy-300 focus:border-gold-500 focus:outline-none transition-colors;
  }
</style>

<script>
  const form = document.getElementById('quiz-form') as HTMLFormElement;
  const results = document.getElementById('quiz-results')!;
  const grid = document.getElementById('quiz-grid')!;
  const empty = document.getElementById('quiz-empty')!;
  const count = document.getElementById('quiz-count')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>(':scope > div'));

  /** GPA scales aren't comparable raw (2.5/4.0 vs 8/10 vs 75/100) — normalize. */
  function toPercent(value: number, scale: string): number {
    const max = scale === '100' ? 100 : parseFloat(scale);
    return (value / max) * 100;
  }

  function countLabel(n: number): string {
    if (n === 1) return 'منحة واحدة مطابقة';
    if (n === 2) return 'منحتان مطابقتان';
    if (n >= 3 && n <= 10) return `${n} منح مطابقة`;
    return `${n} منحة مطابقة`;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const degreeLevel = String(data.get('degreeLevel'));
    const category = String(data.get('category'));
    const country = String(data.get('country'));
    const gpaRaw = data.get('gpa');
    const gpaScale = String(data.get('gpaScale') ?? '4.0');
    const userPercent = gpaRaw ? toPercent(parseFloat(String(gpaRaw)), gpaScale) : null;

    let visible = 0;
    for (const card of cards) {
      const cardCategories = (card.dataset.categories ?? '').split('|');
      const gpaMinRaw = card.dataset.gpamin;
      const minPercent = gpaMinRaw
        ? toPercent(parseFloat(gpaMinRaw), card.dataset.gpascale ?? '4.0')
        : null;

      const match =
        (degreeLevel === 'any' || card.dataset.degree === degreeLevel) &&
        (category === 'any' ||
          cardCategories.includes(category) ||
          cardCategories.includes('جميع التخصصات')) &&
        (country === 'any' || card.dataset.country === country) &&
        (userPercent === null || minPercent === null || userPercent >= minPercent);

      card.hidden = !match;
      if (match) visible++;
    }

    results.hidden = false;
    empty.hidden = visible > 0;
    grid.hidden = visible === 0;
    count.textContent = visible > 0 ? countLabel(visible) : '';
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
